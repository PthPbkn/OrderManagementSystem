@model OrderManagementSystem.Entity.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h4>Edit Product Details</h4>
<div class="card shadow p-4">

    <form asp-action="Edit" method="post" class="form-inline" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @await Html.PartialAsync("_AddEditPartial")
       
        <div class="d-grid gap-2 d-md-flex justify-content-md-end pt-5 pb-2">
                <input type="submit" value="Save" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-danger">Cancel</a>
        </div>
    </form>
</div>
