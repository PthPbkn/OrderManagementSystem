@model OrderManagementSystem.Entity.Models.Product

@{
    ViewData["Title"] = "Create";
}

<h1>Product </h1>

<h6>Create new product</h6>
<hr />

<form asp-action="Create" method="post" class="form-inline" enctype="multipart/form-data">
         <div asp-validation-summary="ModelOnly" class="text-danger"></div> 

<div class="row md-4">
        <div class="col">
            <div class="form-group pb-3">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="SupplierId" class="control-label"></label>
                <select asp-for="SupplierId" asp-items="@Model.SupplierList" class="form-control">
                    <option value="0"> --- Select Supplier --- </option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" asp-items="@Model.CategoryList" class="form-control">
                    <option value="0"> --- Select Category --- </option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>


            <div class="form-group pb-3">
                <label asp-for="QuantityPerUnit" class="control-label"></label>
                <input asp-for="QuantityPerUnit" class="form-control" />
                <span asp-validation-for="QuantityPerUnit" class="text-danger"></span>
            </div>

            <div class="form-group pb-3">
                <label asp-for="UnitPrice" class="control-label"></label>
                <input asp-for="UnitPrice" class="form-control" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>
           
            
        </div>
        <div class="col">
            <div class="form-group pb-3">
                <label asp-for="UnitsInStock" class="control-label"></label>
                <input asp-for="UnitsInStock" class="form-control" />
                <span asp-validation-for="UnitsInStock" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="UnitsOnOrder" class="control-label"></label>
                <input asp-for="UnitsOnOrder" class="form-control" />
                <span asp-validation-for="UnitsOnOrder" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="RecorderLevel" class="control-label"></label>
                <input asp-for="RecorderLevel" class="form-control" />
                <span asp-validation-for="RecorderLevel" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="Discontinued" class="control-label"></label>
                <select asp-for="Discontinued" class="form-control">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
                <span asp-validation-for="Discontinued" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <label asp-for="ImagePath" class="control-label"></label>
                <input asp-for="File" class="custom-file-input form-control" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
            <div class="form-group pb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </div>

</div>
    </form>







<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
