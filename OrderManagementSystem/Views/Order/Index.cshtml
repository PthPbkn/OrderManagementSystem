@model IEnumerable<OrderManagementSystem.Entity.ViewModels.OrderViewModel>
@{
    ViewData["Title"] = "Index";
}


@section styles
{
    <link href="~/datatables/css/jquery.datatables.min.css" rel="stylesheet" />
}


<div class="card shadow p-5">
    <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="fa-solid fa-house"></i></a>
        <a asp-action="Create" class="btn btn-primary">Create New Invoice</a>
    </div>
<table class="hover display mt-5" id="InvoiceTable">
    <thead>
        <tr>            
            <th>
                @Html.DisplayNameFor(model => model.InvoiceID)
            </th>
            <th>                
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerName)                
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalAmount)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>                
                <td>
                        <input id="getOrderIdForClickEvent" asp-for="@item.OrderID" value="@item.OrderID" type="text"  hidden/>
                    @Html.DisplayFor(modelItem => item.InvoiceID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderDate)                    
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)                    
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TotalAmount)
                </td>                
            </tr>
        }
    </tbody>
</table>
</div>

@section scripts
{
    <script src="~/datatables/js/datatables.datatables.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#InvoiceTable').DataTable();

            $("#InvoiceTable").on('click', 'tr', function () {
                var orderID = parseInt($(this).find("#getOrderIdForClickEvent").val());
                //alert(orderID);

                window.location.href = '@Url.Action("Details", "Order")/' + orderID;
            });

        });
    </script>

}