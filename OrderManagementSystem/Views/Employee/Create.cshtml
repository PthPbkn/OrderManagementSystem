@model OrderManagementSystem.Entity.Models.Employee

@{
    ViewData["Title"] = "Create";
}


<h4>New Employee</h4>

@* <div class="row">
    <div class="col-md-4"> *@
<div class="card shadow p-5">
    <form asp-action="Create" method="post" class="form-inline" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @await Html.PartialAsync("_AddEditPartial")

        <div class="form-group d-grid gap-2 d-md-flex justify-content-md-end pt-4">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-danger">Cancel</a>
        </div>
    </form>       
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
