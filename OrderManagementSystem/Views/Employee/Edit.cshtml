@model OrderManagementSystem.Entity.Models.Employee

@{
    ViewData["Title"] = "Edit";
}


<h4>Edit Employee Details</h4>

<div class="card shadow p-5">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EmployeeID" />
            @await Html.PartialAsync("_AddEditPartial")

        <div class="form-group d-grid gap-2 d-md-flex justify-content-md-end pt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
            <a asp-action="Details" asp-route-id="@Model.EmployeeID" class="btn btn-danger">Cancel</a>
            </div>
        </form>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
