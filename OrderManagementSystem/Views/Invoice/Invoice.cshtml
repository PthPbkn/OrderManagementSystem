@model OrderManagementSystem.Entity.ViewModels.InvoiceViewModel

@{
    ViewData["Title"] = "Invoice";
}


<h4>Invoice</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="SupplierName" class="control-label"></label>
                <select asp-for="SupplierName" asp-items="@Model.SupplierList" class="form-control"></select>
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                @* <select asp-for="Address" asp-items="@Model.Address" class="form-control"></select> *@
                @* <p>Your place is: @Model.Address</p>
                @Html.DisplayNameFor(model => model.Address) *@
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
