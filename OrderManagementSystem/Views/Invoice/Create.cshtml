@model OrderManagementSystem.Entity.ViewModels.InvoiceViewModel

@{
    ViewData["Title"] = "Create";
}


@* Supplier Card*@

<form asp-action="Create" method="post" class="form-inline" enctype="multipart/form-data">
    <div class="card shadow mb-5">
        <div class="card-header">
            Supplier
        </div>
        <div class="card-body">
            <table class="table table-borderless">
                <tr>
                    <td>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            @* <label asp-for="SupplierName" class="control-label"></label> *@
                            <select asp-for="SupplierId" asp-items="@Model.SupplierList" class="form-control" id="Suppliers">
                                <option value="0"> --- Select Supplier --- </option>
                            </select>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            @* <label asp-for="Address" class="control-label"></label> *@
                            <input id="SuppAddress" type="text" asp-for="Address" value="Address" class="form-control" readonly />
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            @* <label asp-for="Phone" class="control-label"></label> *@
                            <input id="SuppCity" type="text" asp-for="City" value="City" class="form-control" readonly />
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            @* <label asp-for="Phone" class="control-label"></label> *@
                            <input id="SuppPost" type="text" asp-for="PostCode" value="PostCode" class="form-control" readonly />
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            @* <label asp-for="Phone" class="control-label"></label> *@
                            <input id="SuppPhone" type="text" asp-for="Phone" value="Phone" class="form-control" readonly />
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>



    @* Products Card*@
    <div class="card shadow mb-5">
        <div class="card-header">
            Products
        </div>
        <div class="card-body">
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="ProductName" class="control-label" style="font-size:12px;"></label>
                                <select id="productsMenu" asp-for="ProductID" asp-items="@Model.ProductsList" class="form-control">
                                    <option value="0">--- Products ---</option>
                                </select>

                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <label asp-for="UnitPrice" class="control-label" style="font-size:12px;"></label>
                                <span>
                                    <input id="UnitPrice" asp-for="UnitPrice" type="text" value="0" class="form-control" readonly />
                                </span>
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <label asp-for="UnitsInStock" class="control-label" style="font-size:12px;"></label>
                                <input id="UnitsInStock" asp-for="UnitsInStock" type="text" value="0" class="form-control" readonly />
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <label asp-for="UnitsOnOrder" class="control-label" style="font-size:12px;"></label>
                                <input id="Quantity" asp-for="UnitsOnOrder" type="text" value="0" class="form-control" />
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <label asp-for="Amount" class="control-label" style="font-size:12px;"></label>
                                <input id="total" type="text" value="" class="form-control" />
                                <input id="totalID" asp-for="Amount" type="text" value=""/>
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <input id="addItem" type="button" value="+" class="btn btn-primary form-control" />
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* Invoice Card*@


    <div class="card shadow mb-5">
        <div class="card-body">
            <div class="container mb-5 mt-3">
                <div class="row d-flex align-items-baseline">
                    <div class="col-xl-9">
                        <p style="color: #7e8d9f;font-size: 20px;"><strong>ID: #10001246</strong></p>
                        <input id="InvoiceId" asp-for="InvoiceId" value="" hidden />
                    </div>
                    <div class="col-xl-3 float-end">
                        <a data-mdb-ripple-init class="btn btn-light text-capitalize border-0" data-mdb-ripple-color="dark">
                            <i class="fas fa-print text-primary"></i> Print
                        </a>
                        <a data-mdb-ripple-init class="btn btn-light text-capitalize" data-mdb-ripple-color="dark">
                            <i class="far fa-file-pdf text-danger"></i> Export
                        </a>
                    </div>
                    <hr>
                </div>

                <div class="container">
                    <div class="col-md-12">
                        <div class="text-center">
                            <p class="font-weight-bold" style="color:#5d9fc5;">Order Management System</p>
                        </div>

                    </div>


                    <div class="row">
                        <div class="col-xl-8">
                            <ul class="list-unstyled">
                                <li class="text-muted">To: <span id="supName" style="color:#5d9fc5 ;">Supplier Name</span></li>
                                <li class="text-muted"><span id="SupAddress">address</span></li>
                                <li class="text-muted"><span id="SupCity">address</span></li>
                                <li class="text-muted"><span id="SupPost">post</span></li>
                                <li class="text-muted"><i id="supPhone" class="fas fa-phone"></i><span id="SupPhone">000-00-000</span></li>
                            </ul>
                        </div>
                        <div class="col-xl-4">
                            @* <p class="text-muted">Invoice</p> *@
                            <ul class="list-unstyled">
                                <li class="text-muted">
                                    <i class="fas fa-circle" style="color:#84B0CA ;"></i> <span class="fw-bold">Invoice ID:</span>#123-456
                                </li>
                                <li class="text-muted">
                                    <i class="fas fa-circle" style="color:#84B0CA ;"></i> <span class="fw-bold">Date: </span>@ViewBag.Date
                                </li>
                                @* <li class="text-muted">
                                <i class="fas fa-circle" style="color:#84B0CA ;"></i> <span class="me-1 fw-bold">Status:</span><span class="badge bg-warning text-black fw-bold">
                                Unpaid
                                </span>
                                </li> *@
                            </ul>
                        </div>
                    </div>

                    <div class="row my-2 mx-1 justify-content-center">
                        <table id="invoiceTable" class="table table-striped table-borderless">
                            <thead style="background-color:#84B0CA ;" class="text-white">
                                <tr>
                                    <th scope="col">Item</th>
                                    <th scope="col">Unit Price</th>
                                    <th scope="col">Quantity</th>
                                    <th class="totalamt" scope="col">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>

                        </table>
                    </div>
                    <div class="row">
                        <div class="col-xl-8">
                            <p class="ms-3">Add additional notes and payment information</p>
                        </div>
                        <div class="col-xl-3">
                            <ul class="list-unstyled">
                                <li class="text-muted ms-3">
                                    <span class="text-black me-4">SubTotal : </span>
                                    <span id="subTotal">
                                        0.00
                                    </span>
                                </li>
                                <li class="text-muted ms-3">
                                    <input id="subTotalID" value="" asp-for="SubTotal"/>
                                </li>
                                <li class="text-muted ms-3 mt-2">
                                    <span class="text-black me-4">Tax(15%) : </span>
                                    <span id="tax">0.00</span>
                                    <input id="TaxID" asp-for="Tax" value="" />
                                </li>
                                <li>
                                    <input id="TotalAmtID" asp-for="TotalAmt" value=""/>
                                </li>
                            </ul>
                            <p class="text-black float-start">
                                <span class="text-black me-3">Total Amount : </span>
                                <span id="totalBill" style="font-size: 25px;">0.00</span>                                
                            </p>
                            
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-xl-10">
                            <p>Thank you for your purchase</p>
                        </div>
                        <div class="col-xl-2">
                            <button value="Create" type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary text-capitalize"
                                    style="background-color:#60bdf3;">
                                Create
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            var sum = 0;
            var itemTotal = 0;
            $('#Suppliers').change(function () {
                //debugger;
                var supplierId = $("#Suppliers").val();
                $('#supName').text($("#Suppliers option:selected").text()); // set supplier name on invoice
                $.ajax({
                    url: '@Url.Action("GetSupplierById", "Invoice")',
                    data: { "Id": supplierId },
                    contentType: 'application/json',
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        //console.log(response);
                        $('#SuppAddress').val(response.address);
                        $('#SupAddress').text(response.address);
                        $('#SuppCity').val(response.city);
                        $('#SuppPost').val(response.postCode);
                        $('#SuppPhone').val(response.phone);
                        $('#SupCity').text(response.city);
                        $('#SupPost').text(response.postCode);
                        $('#SupPhone').text(response.phone);
                    },
                    error: function (error) {
                        alert("Failure" + error)
                    }
                });
                $.ajax({
                    url: '@Url.Action("GetProducts", "Invoice")',
                    data: { "Id": supplierId },
                    contentType: 'application/json',
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        console.log(data);
                        $('#productsMenu').empty();
                        var dummy = "<option value=0> --- Products --- </option>"
                        $(dummy).appendTo('#productsMenu');
                        $.each(data, function (i, obj) {
                            //console.log(obj.productName);
                            var menuItems = "<option value=" + obj.productID + ">" + obj.productName + "</option>";
                            //console.log(menuItems);
                            $(menuItems).appendTo('#productsMenu');
                        });
                    },
                    error: function (error) {
                        alert("Error: " + error);
                    }
                });
            });


            $('#productsMenu').change(function () {
                let productId = $('#productsMenu').val();
                $.ajax({
                    url: '@Url.Action("GetProductDetails", "Invoice")',
                    data: { "Id": productId },
                    contentType: 'application/json',
                    type: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        console.log(response);
                        $('#UnitPrice').val(response.unitPrice);
                        $('#UnitsInStock').val(response.unitsInStock);
                    },
                    error: function (error) {
                        alert("failure." + error);
                    }
                });
            });


            $('#addItem').click(function () {
                let item = $("#productsMenu option:selected").text();
                let qty = parseInt($('#Quantity').val());
                let price = parseFloat($('#UnitPrice').val());
                //let amount = $('#total').val();
                //alert('total: ' + format.format(itemTotal))
                $('#totalID').val(format.format(itemTotal));
                //debugger;
                //var sum = 0;
                if (item != '') {
                    var row = $('<tr> <td> ' + item + ' </td > <td> ' + '£' + price + '</td> <td> ' + qty + ' </td> <td>' + formatWithSymbol.format(itemTotal) + ' </td> </tr > ');
                    $('#invoiceTable tbody').append(row);
                    $('#price').val('');
                    $('#qty').val('');
                    $('#total').val('£0.00');

                    //calculate sub total
                    sum = sum + parseFloat(itemTotal);
                    //$('#amount').val('');
                    $('#subTotal').text(formatWithSymbol.format(sum));
                    $('#subTotalID').val(format.format(sum));
                    //subTotal = sum;
                    //console.log('sum: ' + amount);

                    //Calculate tax
                    var tax = sum / 100 * 15;
                    $('#tax').text(formatWithSymbol.format(tax));
                    $('#TaxID').val(format.format(tax));
                    alert('tax: ' + (format.format(tax)));


                    //calculate total amount
                    var total = sum + parseFloat(tax);
                    $('#totalBill').text(formatWithSymbol.format(total));
                    $('#TotalAmtID').val(format.format(total).replace('GBP', '').trim());
                    console.log('Total: ' + total);

                }
                else {
                    alert('Please select an item')
                }
            });

            $('#Quantity').focus(function () {
                $('#Quantity').val('');
            });

            $('#Quantity').blur(function () {
                let quantity = parseInt($('#Quantity').val());
                let unitPrice = parseFloat($('#UnitPrice').val());
                if (quantity) {
                    itemTotal = quantity * unitPrice;
                    let stock = parseInt($('#UnitsInStock').val());
                    let realStock = stock - quantity;
                    $('#UnitsInStock').val(realStock);
                    $('#total').val(formatWithSymbol.format(itemTotal));
                    
                }
            });
            let format = new Intl.NumberFormat({
                style: 'currency',
                currency: 'GBP',
                minimumFractionDigits: 2,
                currencyDisplay:'code'
            });

            let formatWithSymbol = new Intl.NumberFormat('en-GB', {
                style:'currency',
                currency:'GBP',
                minimumFractionDigits: 2,
            });
        });
    </script>

}





