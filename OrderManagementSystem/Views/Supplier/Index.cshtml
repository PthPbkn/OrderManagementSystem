@model IEnumerable<OrderManagementSystem.Entity.Models.Supplier>

@{
    ViewData["Title"] = "Index";
}


@section styles
{
    <link href="~/datatables/css/jquery.datatables.min.css" rel="stylesheet" />
}

<div class="card shadow p-4">

    <div class="row">
        <div class="col">
            <h5>Supplier List</h5>
        </div>
        <div class="col gap-2 d-grid d-md-flex justify-content-md-end pb-4">
            <a asp-action="Create" class="btn btn-success">Create New Supplier</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary"><i class="fa-solid fa-house"></i></a>
        </div>
    </div>


<table id="supplierTable" class="hover display">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SupplierName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PostCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.SupplierName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.City)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PostCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SupplierId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.SupplierId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.SupplierId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>


@section scripts
{
    <script src="~/datatables/js/datatables.datatables.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#supplierTable').DataTable();


        });
    </script>

}

